# Force CRLF line endings for Windows batch files so cmd.exe can parse them
# regardless of the user's core.autocrlf setting.
*.bat text eol=crlf

# Markdown checks out LF everywhere, whatever core.autocrlf says. Documents in
# docs/ are mirrored byte-for-byte against the BMCU-Link repository, which is
# LF-only; with autocrlf on, markdown fell through to CRLF here and a plain
# diff between the two copies reported every line as changed. The mirroring
# rule is only enforceable if the copies can be compared.
*.md text eol=lf

# The mirrored registries are JSON, so the rule above does not reach them, and
# they are compared byte-for-byte for the same reason the documents are.
docs/bmcu_binary_registry.json text eol=lf
docs/bmcu_link_enum_registry.json text eol=lf
